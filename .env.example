PORT=3003
NODE_ENV=development
TRUST_PROXY_HOPS=1

# Neon Postgres
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
DATABASE_URL_POOLED=postgresql://user:password@host-pooler/neondb?sslmode=require=

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d
JWT_TEMP_EXPIRES_IN=10m

# OTP
OTP_LENGTH=6
OTP_EXPIRES_IN=600
OTP_MAX_ATTEMPTS=5
OTP_BLOCK_DURATION=900

# CORS / frontends
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
API_RATE_LIMIT_PER_MIN=120

# Zepto Mail API
ZEPTOMAIL_HOST=smtp.zeptomail.com
ZEPTOMAIL_PORT=465
ZEPTOMAIL_USER=emailapikey
ZEPTOMAIL_API_KEY=your-zeptomail-api-key
EMAIL_FROM_NAME=Glowbe Nexus
EMAIL_FROM=noreply@your-verified-domain.com
